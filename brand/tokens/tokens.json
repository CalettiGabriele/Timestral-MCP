{
  "$description": "Timestral MCP design tokens. Source of truth for docs, MCP apps and any future website.",
  "color": {
    "ink": "#141414",
    "graphite": "#4A463F",
    "stone": "#8A8375",
    "sand": "#C2BAAC",
    "linen": "#D9D2C7",
    "paper": "#E3DED5",
    "white": "#FFFFFF",
    "ultramarine": "#2336BC",
    "ultramarine-500": "#3E4FC8",
    "ultramarine-400": "#5464CC",
    "ultramarine-200": "#9AA5E4",
    "ultramarine-100": "#C9CFF2",
    "ultramarine-50": "#DDE1F7",
    "signal-red": "#BC2323",
    "signal-green": "#1F6B3C",
    "signal-amber": "#C77E00"
  },
  "role": {
    "light": {
      "background": "paper",
      "surface": "linen",
      "surface-raised": "white",
      "text": "ink",
      "text-secondary": "graphite",
      "text-muted": "stone",
      "border": "sand",
      "accent": "ultramarine",
      "accent-text": "ultramarine",
      "on-accent": "white"
    },
    "dark": {
      "background": "ink",
      "surface": "#1E1D1B",
      "surface-raised": "#282624",
      "text": "paper",
      "text-secondary": "sand",
      "text-muted": "stone",
      "border": "graphite",
      "accent": "ultramarine",
      "accent-text": "ultramarine-200",
      "on-accent": "white"
    }
  },
  "chart": {
    "history": "ink",
    "history-dark": "paper",
    "median": "ultramarine",
    "median-dark": "ultramarine-200",
    "band-98": "ultramarine-50",
    "band-90": "ultramarine-100",
    "band-80": "ultramarine-200",
    "band-50": "ultramarine-400",
    "actuals": "stone",
    "anomaly": "signal-red"
  },
  "font": {
    "display": "Arial, 'Helvetica Neue', Helvetica, 'Liberation Sans', sans-serif",
    "body": "Calibri, Carlito, 'Segoe UI', Arial, sans-serif",
    "mono": "'Courier New', Courier, 'Liberation Mono', monospace"
  },
  "type": {
    "statement": { "font": "display", "weight": 700, "size": "62px", "tracking": "-0.035em" },
    "title": { "font": "display", "weight": 700, "size": "34px", "tracking": "-0.02em" },
    "body": { "font": "body", "weight": 400, "size": "15px", "line-height": 1.6 },
    "label": { "font": "mono", "weight": 400, "size": "11px", "tracking": "0.22em", "transform": "uppercase" }
  },
  "radius": "0px",
  "rule": { "identity": "4px", "hairline": "1px" }
}
